{
  "name": "@concordia-protocol/sdk",
  "version": "0.0.1-alpha.10",
  "description": "TypeScript reference implementation of the Concordia Protocol -- signed agreement primitives for autonomous agents",
  "license": "Apache-2.0",
  "author": "Erik Newton <eriknewton@gmail.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "ajv": "^8.16",
    "ajv-formats": "^3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^20",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.8.4",
    "tsup": "^8.5.1",
    "tsx": "^4",
    "typescript": "^5.3",
    "typescript-eslint": "^8.61.1",
    "vitest": "^3.2.6"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "vite": "^6.4.3"
  }
}
